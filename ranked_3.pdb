        "<a href=\"https://colab.research.google.com/github/maryjuju-biomed/maya/blob/main/ranked_3.pdb\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
